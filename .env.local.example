# ════════════════════════════════════════════════════════════════════
# Adekagagwaa Dashboard — environment variables
# ════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env.local` for local dev, and set the same vars
# on the Vercel project (Production, Preview, Development scopes) for
# deployed environments.  Never commit .env.local.

# ── Phase 6 analytics reads ─────────────────────────────────────────
#
# Dedicated least-privilege Postgres role for reading analytics.*
# materialized views.  Created by bot-repo migration 025.  USE THE
# SUPABASE TRANSACTION POOLER URL (port 5432, host pattern
# db.<project>.pooler.supabase.com) — required for serverless.
#
# Format: postgresql://analytics_reader:<password>@<pooler-host>:5432/postgres
#
# This is NOT the same as the bot's DATABASE_URL.  The bot uses
# service_role-equivalent direct DB credentials.  This dashboard
# uses analytics_reader, which has SELECT only on the analytics
# schema.

DATABASE_URL_READER=postgresql://analytics_reader:CHANGE_ME@db.YOUR_PROJECT.pooler.supabase.com:5432/postgres

# ── Auth ────────────────────────────────────────────────────────────
#
# Site password — single shared secret.  Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SITE_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# JWT signing secret for the session cookie.  Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 bytes of entropy.  Rotating this invalidates all
# sessions (forces re-login).
DASHBOARD_JWT_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING

# ── Railway pass-through (v1 keys: live state, recent_signals, etc.)
#
# The Vercel handler fetches the bot's existing /dashboard.json
# server-side so the v2 payload is a backward-compatible superset.
# These two vars match what was previously NEXT_PUBLIC_DASHBOARD_URL
# and NEXT_PUBLIC_DASHBOARD_TOKEN on the dashboard repo, but now
# WITHOUT the NEXT_PUBLIC_ prefix because the values stay server-
# side and never reach the browser.

RAILWAY_DASHBOARD_URL=https://adekagagwaa-production.up.railway.app/dashboard.json
RAILWAY_DASHBOARD_TOKEN=

# ════════════════════════════════════════════════════════════════════
# DO NOT SET ANY NEXT_PUBLIC_* ENV VARS FOR THESE.
# Phase 6 moved the secrets server-side; exposing any of them via
# NEXT_PUBLIC_ would defeat the security posture of the entire
# dashboard auth refactor.
# ════════════════════════════════════════════════════════════════════
